// Force the post-2020 split of google.golang.org/genproto so transitive
// deps (etcd, grpc) resolve annotations/status against the modern
// google.golang.org/genproto/googleapis/{api,rpc} modules instead of the
// legacy monolithic package, which would otherwise create ambiguous
// imports on a fresh go.sum (Go 1.21+ behaviour).
exclude google.golang.org/genproto v0.0.0-20180817151627-c66870c02cf8

exclude google.golang.org/genproto v0.0.0-20190819201941-24fa4b261c55

