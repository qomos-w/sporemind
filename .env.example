# sporemind env — 统一配置源（复制为 .env 后生效）
# .env 已加入 .gitignore，此文件为模板

# ---------------------------------------------------------------------------
# Public tier — 可暴露给前端，可打包进产物
# ---------------------------------------------------------------------------

# Web API base (Vite dev only; production uses same-origin)
VITE_API_BASE=http://127.0.0.1:18080/api/v0alpha1

# Mobile login defaults
DEFAULT_SERVER_URLS=["http://192.168.0.1:18080"]
DEFAULT_ACCOUNT=admin

# ---------------------------------------------------------------------------
# Runtime secrets — 不进任何构建产物，通过 os.Getenv / license actor 获取
# ---------------------------------------------------------------------------

SPOREMIND_API_KEY=
SPOREMIND_JWT_SECRET=
SPOREMIND_CDKEY=

# ---------------------------------------------------------------------------
# LLM provider config
# ---------------------------------------------------------------------------

SPOREMIND_ANTHROPIC_API_KEY=
SPOREMIND_ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
SPOREMIND_ANTHROPIC_MODEL=glm-5.1

SPOREMIND_OPENAI_API_KEY=
SPOREMIND_OPENAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
SPOREMIND_OPENAI_MODEL=glm-5.1
