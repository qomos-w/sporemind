{
  "name": "@qomos/spore-ts",
  "version": "0.1.0",
  "description": "TypeScript runtime for the spore protocol layer (schema, codec, identity).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qomos-w/spore.git",
    "directory": "ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./src/schema.ts"
    },
    "./codec": {
      "types": "./src/codec.ts",
      "import": "./src/codec.ts"
    },
    "./binary_codec": {
      "types": "./src/binary_codec.ts",
      "import": "./src/binary_codec.ts"
    },
    "./identity": {
      "types": "./src/identity.ts",
      "import": "./src/identity.ts"
    },
    "./registry": {
      "types": "./src/registry.ts",
      "import": "./src/registry.ts"
    },
    "./callables": {
      "types": "./src/callables.ts",
      "import": "./src/callables.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
