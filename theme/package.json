{
  "name": "@qomos/sporemind-theme",
  "version": "0.1.0",
  "description": "Myxos design tokens (CSS) + theme apply/parse helpers. Pure: no dependencies, no DOM coupling beyond document.documentElement.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./tokens.css": "./src/tokens.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "license": "MIT"
}
