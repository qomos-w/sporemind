// shell.env namespace — shell environment detection and user preference wire
// shapes. Sources of truth for:
//   - workspace.shell_env_probe: list detected shell candidates + current
//   - workspace.shell_pref_save: persist the user's preferred shell kind
// @ts-export

struct ShellCandidate {
    Kind:       string   // "bash" | "gitbash" | "powershell5" | "powershell7" | "cmd" | "sh"
    Executable: string   // resolved path; empty when Available is false
    optional ExtraBin: array<string>
    Available:  bool
}


struct ShellEnvProbeResp {
    Current:     ShellCandidate   // currently effective shell
    Candidates:  array<ShellCandidate>
    Platform:    string           // runtime.GOOS
}


struct ShellPrefSaveReq {
    RequestId:   string
    Kind:        string           // "" = auto; otherwise a ShellKind value
}


struct ShellPrefSaveResp {
    Kind:    string                // the saved kind ("" = auto)
    Current: ShellCandidate        // effective shell after applying the preference
}
