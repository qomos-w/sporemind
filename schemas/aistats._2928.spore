// aistats namespace — durable, auditable LLM request telemetry and cost accounting.
//
// Sources of truth for:
//   - per-request stats captured by aiaggregator after each dispatch
//   - session/project/workspace/model/provider aggregations
//   - cost rate configuration and cost estimation
//   - query/export surfaces exposed by the aistats actor
//
// All timestamps are RFC3339Nano strings unless noted otherwise.
// @ts-export

// AIStatsRecord is the immutable per-request unit. It mirrors TurnRequestStat
// but carries full workspace/session routing metadata.
struct AIStatsRecord {
    Id:                    string       // UUIDv7 / ULID
    WorkspaceId:           string
    ProjectId:             string
    AgentId:               string
    SessionId:             string
    TurnId:                string
    RequestId:             string       // internal request id generated by aggregator

    Provider:              string
    Model:                 string
    optional ResponseModel: string
    optional ResponseId:     string       // provider-side response id
    optional ClientRequestId: string     // x-request-id / anthropic-rq-id header value

    optional Usage:        UsageData
    optional StopReason:   string         // stop | length | toolUse | error | aborted
    optional ErrorCode:    string         // canonical failure category (rate_limit | overloaded | server_error | auth | timeout | client_error | content_filter | unknown)
    optional ErrorMessage: string

    optional LatencyMs:    long           // full response latency
    optional FirstTokenMs: long           // time to first token
    StartedAt:             string
    CompletedAt:           string

    optional Tags:         map<string, string>   // e.g., "kind": "primary" | "fast" | "summary"
}


// TurnRequestStat is a trimmed request stat meant to be embedded inside a Turn.
struct TurnRequestStat {
    Id:                    string
    Provider:              string
    Model:                 string
    optional ResponseModel: string
    optional ResponseId:     string
    optional RequestId:      string
    optional Usage:        UsageData
    optional StopReason:   string
    optional ErrorCode:    string
    optional ErrorMessage: string
    optional LatencyMs:    long
    optional FirstTokenMs: long
    optional StartedAt:    string
    optional CompletedAt:  string
}


// Cost rates for a single provider/model combination. Versioned so historical
// records can be re-costed against the rate that was current at request time.
struct AIStatsCostRate {
    Provider:       string
    Model:          string
    Version:        long         // monotonic version, incremented on each update
    UpdatedAt:      string

    CostInput:      double       // $ per 1M tokens
    CostOutput:     double       // $ per 1M tokens
    CostCacheRead:  double       // $ per 1M tokens
    optional CostCacheWrite: double  // $ per 1M tokens; defaults to CostInput * 2 for Anthropic-style 1h write
    optional Tiers: array<AIStatsCostTier>
}


struct AIStatsCostTier {
    InputTokensAbove: long
    CostInput:        double
    CostOutput:       double
    CostCacheRead:    double
    optional CostCacheWrite: double
}


// Aggregate counters kept in memory and persisted to disk as checkpoints.
// All counters are monotonic and can be reconstructed by replaying records.
struct AIStatsCounters {
    RequestCount:             long
    ErrorCount:               long
    LatencySumMs:             long
    InputTokens:              long
    OutputTokens:             long
    TotalTokens:              long
    CacheCreationInputTokens: long
    CacheReadInputTokens:     long
    ReasoningTokens:          long
    CostInput:                double
    CostOutput:               double
    CostCacheRead:            double
    CostCacheWrite:           double
    CostTotal:                double
}


struct AIStatsSessionAggregate {
    SessionId:      string
    Counters:       AIStatsCounters
    LastRecordAt:   string
}


struct AIStatsProjectAggregate {
    ProjectId:      string
    Counters:       AIStatsCounters
    LastRecordAt:   string
}


struct AIStatsWorkspaceAggregate {
    WorkspaceId:    string
    Counters:       AIStatsCounters
    LastRecordAt:   string
}


struct AIStatsProviderAggregate {
    Provider:       string
    Counters:       AIStatsCounters
    LastRecordAt:   string
}


struct AIStatsModelAggregate {
    Provider:       string
    Model:          string
    Counters:       AIStatsCounters
    LastRecordAt:   string
}


// --- callables ---

struct AIStatsRecordReq {
    Record: AIStatsRecord
}


struct AIStatsRecordResp {
    Id: string
}


struct AIStatsQueryReq {
    Scope:     string   // "session" | "project" | "workspace" | "provider" | "model"
    ScopeId:   string   // sessionId/projectId/workspaceId; for provider/model, format "provider" or "provider/model"
    optional WorkspaceID: string  // empty = global (cross-workspace) aggregation; set = filter to one workspace
    optional Since: string       // RFC3339Nano
    optional Until: string       // RFC3339Nano
    optional Limit: int
    optional Offset: int
    optional Order: string       // "asc" (default) | "desc" — sort by CompletedAt
}


struct AIStatsQueryResp {
    Records:    array<AIStatsRecord>
    Counters:   AIStatsCounters
    Total:      long             // total matching records before limit/offset
}


struct AIStatsCostConfigureReq {
    Rate: AIStatsCostRate
}


struct AIStatsCostConfigureResp {
    Version: long
}


struct AIStatsCostListReq {
    optional Provider: string
    optional Model:    string
}


struct AIStatsCostListResp {
    Rates: array<AIStatsCostRate>
}


struct AIStatsExportReq {
    Scope:     string   // "session" | "project" | "workspace" | "provider" | "model"
    ScopeId:   string
    optional WorkspaceID: string  // empty = global; set = filter to one workspace
    optional Since: string
    optional Until: string
    optional Format: string   // "jsonl" (default) | "csv"
}


struct AIStatsExportResp {
    Data: string   // exported payload
}


// AgentSessionStatsReq/Resp are exposed by the agent actor as a thin wrapper
// over aistats.query so the frontend status bar can read totals without
// knowing the workspace-scoped aistats actor id.
struct AgentSessionStatsReq {
    optional SessionId: string   // empty means all records for this agent
    optional Since: string       // RFC3339Nano
    optional Limit: int
}


struct AgentSessionStatsResp {
    Counters:        AIStatsCounters
    CacheHitRate:    double   // cacheRead / (input + cacheRead + cacheWrite); 0 if denominator is 0
    LatestProvider:  string
    LatestModel:     string
}


struct AIStatsBackfillReq {
    WorkspaceId: string
    optional ProjectId: string
    optional AgentId:   string
    optional SessionId: string
}


struct AIStatsBackfillResp {
    RecordCount: long
}


// AIStatsAggregatesReq returns the full in-memory aggregate picture for the
// workspace: the workspace-level totals plus every provider and model-unit
// (provider/model) aggregate. Used by the model-unit performance dashboard to
// render an overview without scanning all records.
struct AIStatsAggregatesReq {
    optional WorkspaceID: string  // empty = global cross-workspace aggregates; set = single workspace breakdown
}


struct AIStatsAggregatesResp {
    Workspace:  AIStatsCounters
    Models:     array<AIStatsModelAggregate>
    Providers:  array<AIStatsProviderAggregate>
}


struct AIStatsBucket {
    Start:           long      // epoch ms (inclusive)
    End:             long      // epoch ms (exclusive)
    Requests:        long
    Errors:          long
    InputTokens:     long
    OutputTokens:    long
    CacheRead:       long
    CacheWrite:      long
    ReasoningTokens: long
    Cost:            double
    LatencyP50:      double
    LatencyP95:      double
    LatencySumMs:    long      // sum of latencies in this bucket (for tok/s)
    TtftP50:         double
    ErrorCodes:      map<string, long>
    optional Rollup: bool      // true = counters merged from rollup documents (已聚合区间), no per-request rows underlie this bucket
    optional Grain:  string    // "raw" | "day" | "month" — granularity floor of the bucket's data source
}


struct AIStatsModelStat {
    Provider:       string
    Model:          string
    Requests:       long
    Errors:         long
    InputTokens:    long
    OutputTokens:   long
    CacheRead:      long
    CacheWrite:     long
    CostTotal:      double
    CostInput:      double
    CostOutput:     double
    CostCacheRead:  double
    CostCacheWrite: double
    LatencyP95:     double
    TtftP50:        double
    LatencySumMs:   long
}


struct AIStatsSeriesReq {
    Scope:      string          // workspace|session|project|provider|model
    ScopeId:    string
    optional WorkspaceID: string  // empty = global; set = filter to one workspace
    optional Since: string      // RFC3339Nano
    optional Until: string      // RFC3339Nano
    optional ModelFilter: string  // case-insensitive substring match on Provider/Model; empty = no filter
    BucketMs:   long            // bucket width in ms; 0 = auto (24h)
}


struct AIStatsSeriesResp {
    Buckets:             array<AIStatsBucket>
    ModelStats:          array<AIStatsModelStat>
    OverallLatencyP50:   double
    OverallLatencyP95:   double
    OverallTtftP50:      double
    OverallLatencySumMs: long
    OverallOutputTokens: long
}
