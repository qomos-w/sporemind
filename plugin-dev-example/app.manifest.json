  "Dependencies": null,
  "Bundles": [
    {
      "Title": "Authenticator Tools",
      "Description": "TOTP account management (Google Authenticator style) with per-app persistent state.\n\n- **authenticator-provision** — add a TOTP account; omit Secret to generate one, set Digits/Period/Algorithm for non-default token shape.\n- **authenticator-codes** — list current codes with seconds remaining; pass AccountId for one account, omit for all.\n- **authenticator-verify** — check a code against an account; Window widens allowed drift in steps (default 1).\n- **authenticator-remove** — delete an account by id.\n\nupdate is not agent-facing (programmatic only).",
      "Icon": "shield-check",
      "Tools": [
        {
          "CallableId": "provision"
        },
        {
          "CallableId": "codes"
        },
        {
          "CallableId": "verify"
        },
        {
          "CallableId": "remove"
        }
      ]
    }
  ],
