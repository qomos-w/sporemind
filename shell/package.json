{
  "name": "@qomos/sporemind-shell",
  "version": "0.1.0",
  "description": "Reusable IDE-style desktop shell — dock layout, TitleBar, ActivityBar, SplitContainer, panel/layout stores. Domain-agnostic via injected adapters (StorageAdapter / WindowController / TabBadgeProvider).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./components/*.css": "./src/components/*.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "lucide-react": ">=0.300.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "lucide-react": "^1.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.5"
  },
  "sideEffects": true,
  "license": "MIT"
}
